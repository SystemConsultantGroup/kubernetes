{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effective SCG application chart values",
  "type": "object",
  "required": ["_context"],
  "properties": {
    "_context": {
      "$ref": "#/$defs/context"
    }
  },
  "patternProperties": {
    "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$": {
      "$ref": "#/$defs/workload"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kubernetesDefinitions": {},
    "httpRouteRule": {},
    "workloadName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "format": "hostname",
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
    },
    "domain": {
      "oneOf": [
        {"$ref": "#/$defs/hostname"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "external"],
          "properties": {
            "name": {"$ref": "#/$defs/hostname"},
            "external": {"type": "boolean"}
          }
        }
      ]
    },
    "domainOrDomains": {
      "oneOf": [
        {"$ref": "#/$defs/domain"},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/domain"}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+\\.git$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^(?:(?:localhost|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)(?::[0-9]{1,5})?)/(?:[a-z0-9]+(?:(?:[._]|__|[-]+)[a-z0-9]+)*/)*[a-z0-9]+(?:(?:[._]|__|[-]+)[a-z0-9]+)*@sha256:[a-f0-9]{64}$"
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "domain": {"$ref": "#/$defs/domainOrDomains"},
        "inject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/httpRouteRule"}
        }
      },
      "allOf": [
        {
          "if": {"required": ["rules"]},
          "then": {"required": ["domain"]}
        },
        {
          "not": {
            "required": ["inject"],
            "properties": {"port": {"const": 15000}}
          }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"$ref": "#/$defs/kubernetesDefinitions/io.k8s.api.core.v1.ResourceRequirements"},
        "env": {
          "type": "array",
          "items": {"$ref": "#/$defs/kubernetesDefinitions/io.k8s.api.core.v1.EnvVar"}
        },
        "envFrom": {
          "type": "array",
          "items": {"$ref": "#/$defs/kubernetesDefinitions/io.k8s.api.core.v1.EnvFromSource"}
        },
        "readinessProbe": {"$ref": "#/$defs/kubernetesDefinitions/io.k8s.api.core.v1.Probe"},
        "http": {"$ref": "#/$defs/http"},
        "source": {"$ref": "#/$defs/source"},
        "image": {"$ref": "#/$defs/image"}
      },
      "dependentRequired": {
        "source": ["image"],
        "image": ["source"]
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "instance", "htmlInjector"],
      "properties": {
        "application": {"$ref": "#/$defs/workloadName"},
        "htmlInjector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wasm"],
          "properties": {
            "wasm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "sha256"],
              "properties": {
                "url": {"type": "string", "format": "uri"},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "instance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["production", "testing", "preview"]},
            "workload": {"$ref": "#/$defs/workloadName"},
            "pullRequest": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "preview"}}, "required": ["type"]},
              "then": {"required": ["workload", "pullRequest"]},
              "else": {
                "not": {
                  "anyOf": [
                    {"required": ["workload"]},
                    {"required": ["pullRequest"]}
                  ]
                }
              }
            }
          ]
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "server": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
