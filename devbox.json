{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
  "packages": [
    "talosctl@latest",
    "kubectl@latest",
    "cilium-cli@latest",
    "kubernetes-helm@latest",
    "sops@latest",
    "age@latest",
    "yq-go@latest"
  ],
  "env": {
    "PATH": "$DEVBOX_PROJECT_ROOT/scripts:$PATH",
    "TALOSCONFIG": "$DEVBOX_PROJECT_ROOT/talosconfig",
    "KUBECONFIG": "$DEVBOX_PROJECT_ROOT/kubeconfig"
  },
  "shell": {
    "init_hook": [
      "if [ -n \"${BASH_VERSION:-}\" ]; then source \"$DEVBOX_PROJECT_ROOT/scripts/completions/t.bash\"; fi"
    ]
  }
}
