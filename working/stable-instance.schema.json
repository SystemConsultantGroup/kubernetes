{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCG production or testing instance",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "minLength": 1,
    "maxLength": 63,
    "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
  },
  "additionalProperties": {
    "$ref": "./lock.schema.json"
  }
}
